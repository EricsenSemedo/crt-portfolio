// Websites form endpoint: verifies Turnstile, saves the inquiry to D1, then emails it through Resend.
// Deploy: bunx wrangler d1 migrations apply cranium-inquiries --remote, then bunx wrangler deploy (from this folder).
// Secrets (set once, never committed): TURNSTILE_SECRET, RESEND_API_KEY.
// Optional secrets: NOTIFY_URL and NOTIFY_TOKEN, a Claude Code routine's API trigger fired per saved inquiry.
{
  "name": "cranium-inquiry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cranium-inquiries",
      "database_id": "d4141828-abe2-4a0d-8b9b-9a06fe347dba",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ericsensemedo.github.io,http://localhost:5173,http://localhost:4173",
    "INQUIRY_TO": "ericsen@cranium.studio",
    "INQUIRY_FROM": "Cranium Studio website <inquiry@form.cranium.studio>"
  }
}
